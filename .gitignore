# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except the committed example).
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key
/config/credentials/*.key


# Ignore SimpleCov coverage output.
/coverage/

# Ignore Node modules (Vitest JS unit tests; app JS still ships via importmap).
/node_modules/

# Ignore the local PokeAPI/sprites checkout (source for committed sprites; not tracked).
/vendor/pokeapi-sprites/

# Images are served from Cloudflare R2, not committed. Keep them locally for uploads
# (deploy/upload-images.sh); they're re-derivable from vendor/pokeapi-sprites. The dir
# itself stays via .keep so Propshaft's image load path survives a fresh clone.
/app/assets/images/*.png
/app/assets/images/**/*.png
# ...except the hand-prepared artwork, which has no source in vendor/ to re-derive it from.
!/app/assets/images/walkthrough/art/*.png
# Same for the Safari bait and rock: the game overloads two badges for them, so PokeAPI has no
# item sprite under either name and there is nothing to re-derive these two from either.
!/app/assets/images/walkthrough/items/bait.png
!/app/assets/images/walkthrough/items/rock.png
# Same again for the box art on the version index and the Porygon that leans on its title: box
# scans and painted art, with nothing in vendor/ that reproduces either.
!/app/assets/images/covers/*.png
!/app/assets/images/porygon-art.png
# Same for the account art: provider marks for the sign-in buttons, and the three trainer avatars
# trimmed from Pokemon Showdown. Neither has a source in vendor/ to re-derive it from.
!/app/assets/images/account/oauth/*.png
!/app/assets/images/account/avatars/*.png
# fingerprint cache for the incremental R2 upload (deploy/upload-images.sh)
/app/assets/images/.r2-upload-cache.json

# generated map QA previews (renders live in R2)
/tools/maps/qa/

# python bytecode
__pycache__/
*.pyc

# pytest / coverage output from the map generator suite (tools/maps)
.pytest_cache/
.coverage
htmlcov/

# Playwright MCP scratch output (screenshots, page snapshots)
.playwright-mcp/
