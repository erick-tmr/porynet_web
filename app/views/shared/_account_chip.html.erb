<% if user_signed_in? %>
  <div class="pn-nav__account" data-controller="disclosure"
       data-action="keydown.esc@window->disclosure#close">
    <button type="button" class="pn-nav__account-toggle" aria-expanded="false"
            aria-controls="pn-account-menu" aria-label="<%= t("account.chip.menu") %>"
            data-disclosure-target="toggle" data-action="disclosure#toggle">
      <span class="pn-nav__account-mark">
        <%= r2_image_tag "account/avatars/#{current_user.avatar}.png", alt: "" %>
      </span>
      <span class="pn-nav__account-hello">
        <%= t("account.chip.hello") %>
        <span class="pn-nav__account-name"><%= current_user.trainer_name.upcase %></span>
      </span>
      <span class="pn-nav__account-caret pn-nav__account-caret--open" aria-hidden="true">▼</span>
      <span class="pn-nav__account-caret pn-nav__account-caret--close" aria-hidden="true">▲</span>
    </button>

    <div class="pn-nav__account-menu" id="pn-account-menu" data-disclosure-target="body" hidden>
      <div class="pn-nav__account-head">
        <span class="pn-nav__account-eyebrow"><%= t("account.chip.save_file") %></span>
        <span class="pn-nav__account-trainer"><%= current_user.trainer_name %></span>
      </div>
      <%= link_to t("account.chip.tracker"), root_path(anchor: "tracker"),
                  class: "pn-nav__account-item" %>
      <% AccountData::MENU_LINKS.each do |item| %>
        <% next if item == "tracker" %>
        <span class="pn-nav__account-item pn-nav__account-item--soon">
          <span><%= t("account.chip.#{item}") %></span>
          <span class="pn-nav__account-soon"><%= t("account.chip.soon") %></span>
        </span>
      <% end %>
      <%= button_to t("account.chip.sign_out"), destroy_user_session_path, method: :delete,
                    class: "pn-nav__account-out", form_class: "pn-nav__account-form" %>
    </div>
  </div>
<% else %>
  <div class="pn-nav__account">
    <span class="pn-nav__account-mark" aria-hidden="true">?</span>
    <span class="pn-nav__account-hello">
      <%= t("account.chip.hello") %>
      <span class="pn-nav__account-guest"><%= t("account.chip.guest") %></span>
    </span>
    <%= link_to t("account.chip.login"), new_user_session_path, class: "pn-nav__account-login" %>
  </div>
<% end %>
