<div class="pn-nav__panel-account">
  <% if user_signed_in? %>
    <span class="pn-nav__account-hello">
      <%= t("account.chip.hello") %>
      <span class="pn-nav__account-name"><%= current_user.trainer_name.upcase %></span>
    </span>
    <%= button_to t("account.chip.logout"), destroy_user_session_path, method: :delete,
                  class: "pn-nav__account-login" %>
  <% else %>
    <span class="pn-nav__account-hello">
      <%= t("account.chip.hello") %>
      <span class="pn-nav__account-guest"><%= t("account.chip.guest") %></span>
    </span>
    <%= link_to t("account.chip.login"), new_user_session_path, class: "pn-nav__account-login" %>
  <% end %>
</div>
