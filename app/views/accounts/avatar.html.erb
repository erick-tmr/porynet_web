<% generation = AccountData.generation(params[:gen]) %>
<% query = params[:q].to_s.strip %>
<% page = AccountData.page(AccountData.search(generation: generation, query: query), params[:page]) %>

<%= render layout: "accounts/shell", locals: { section: "avatar" } do %>
  <%= render layout: "accounts/panel",
             locals: { title: t("account.avatar.title"),
                       meta: t("account.avatar.count",
                               count: AccountData::AVATARS.size) } do %>
    <p class="pn-account__lead"><%= t("account.avatar.lead") %></p>
    <p class="pn-account__credit">
      <%= t("account.avatar.credit_html",
            link: source_link(:showdown, "pn-account__credit-link")) %>
    </p>

    <%= form_with url: account_avatar_path, method: :get, class: "pn-account__search" do |f| %>
      <%= f.hidden_field :gen, value: generation %>
      <%= f.search_field :q, value: query, class: "pn-field__input",
                         placeholder: t("account.avatar.search_placeholder"),
                         "aria-label": t("account.avatar.search_label") %>
      <%= f.submit t("account.avatar.search_submit"), class: "pn-btn pn-btn--sky pn-btn--sm" %>
      <% if query.present? %>
        <%= link_to t("account.avatar.search_clear"), account_avatar_path(gen: generation),
                    class: "pn-account__foot-link" %>
      <% end %>
    <% end %>

    <div class="pn-account__filters">
      <% AccountData::GENERATIONS.each do |name| %>
        <%= link_to t("account.avatar.generations.#{name}"),
                    account_avatar_path(gen: name, q: query.presence),
                    class: class_names("pn-account__filter", "is-active" => name == generation) %>
      <% end %>
    </div>

    <% if page.rows.empty? %>
      <p class="pn-account__badges-empty"><%= t("account.avatar.empty", query: query) %></p>
    <% else %>
      <%= form_with model: current_user, scope: :account_avatar, url: account_avatar_path,
                    method: :patch do |f| %>
        <%= hidden_field_tag :gen, generation %>
        <%= hidden_field_tag :q, query.presence %>
        <%= hidden_field_tag :page, page.number %>
        <div class="pn-auth__avatars pn-account__avatars">
          <% page.rows.each do |avatar| %>
            <%= render "accounts/avatar_card", f: f, avatar: avatar,
                       in_use: avatar.id == current_user.avatar %>
          <% end %>
        </div>

        <div class="pn-account__foot">
          <%= f.submit t("account.avatar.submit"), class: "pn-btn pn-btn--accent" %>
          <%= link_to t("account.avatar.cancel"), account_path, class: "pn-btn pn-btn--muted" %>
        </div>
      <% end %>
    <% end %>

    <% if page.many? %>
      <div class="pn-account__pager">
        <% unless page.first? %>
          <%= link_to t("account.avatar.prev"),
                      account_avatar_path(gen: generation, q: query.presence, page: page.number - 1),
                      class: "pn-btn pn-btn--white pn-btn--sm" %>
        <% end %>
        <span class="pn-account__pager-count">
          <%= t("account.avatar.page", page: page.number, total: page.total) %>
        </span>
        <% unless page.last? %>
          <%= link_to t("account.avatar.next"),
                      account_avatar_path(gen: generation, q: query.presence, page: page.number + 1),
                      class: "pn-btn pn-btn--white pn-btn--sm" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
