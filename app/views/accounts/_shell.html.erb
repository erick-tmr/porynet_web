<% content_for :title, t("account.meta.#{section}") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/auth", "pages/account", "data-turbo-track": "reload" %>
<% end %>
<% content_for :nav_marquee do %>
  <%= render "shared/marquee_row", items: t("account.marquee") %>
  <%= render "shared/marquee_row", items: t("account.marquee") %>
<% end %>

<%= render "accounts/hero", section: section %>

<section class="pn-account">
  <%= render "accounts/rail", section: section %>
  <div class="pn-account__main"><%= yield %></div>
</section>
