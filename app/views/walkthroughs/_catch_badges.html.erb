<div class="pn-wt-catch__badges">
  <% if entry.boxed? %>
    <span class="pn-wt-catchbadge pn-wt-catchbadge--boxed"><%= t("walkthrough.ui.badge_boxed") %></span>
  <% elsif !entry.fresh? %>
    <span class="pn-wt-catchbadge pn-wt-catchbadge--elsewhere"><%= t("walkthrough.ui.badge_elsewhere") %></span>
  <% elsif entry.at != slug %>
    <span class="pn-wt-catchbadge pn-wt-catchbadge--elsewhere">
      <%= t("walkthrough.ui.badge_do_at", stop: entry.stop_name.upcase) %>
    </span>
  <% else %>
    <% if entry.qty.positive? %>
      <span class="pn-wt-catchbadge pn-wt-catchbadge--living">
        <%= t("walkthrough.ui.badge_living", count: entry.qty) %>
      </span>
    <% end %>
    <span class="pn-wt-catchbadge pn-wt-catchbadge--oak"><%= t("walkthrough.ui.badge_oak", count: 1) %></span>
  <% end %>
</div>
