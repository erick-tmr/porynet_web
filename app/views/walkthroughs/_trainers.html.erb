<%# Boss trainers (rival, Team Rocket) get a full-width feature row each; the rest fill the grid. %>
<% show_floor = trainers.filter_map(&:floor).uniq.many? %>
<% trainers.select(&:feature?).each do |trainer| %>
  <div class="pn-wt-trainers pn-wt-trainers--feature">
    <%= render "trainer", trainer: trainer, feature: true, show_floor: show_floor %>
  </div>
<% end %>
<% regular = trainers.reject(&:feature?) %>
<% if regular.any? %>
  <div class="<%= class_names("pn-wt-trainers", "pn-wt-trainers--dense" => dense) %>">
    <% regular.each do |trainer| %>
      <%= render "trainer", trainer: trainer, compact: dense, show_floor: show_floor %>
    <% end %>
  </div>
<% end %>
