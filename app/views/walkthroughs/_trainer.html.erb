<% compact = local_assigns.fetch(:compact, false) %>
<% feature = local_assigns.fetch(:feature, false) %>
<% role = local_assigns[:role] %>
<% floor = trainer.floor if local_assigns[:show_floor] %>
<div class="<%= class_names("pn-wt-trainer", "pn-wt-trainer--compact" => compact, "pn-wt-trainer--feature" => feature) %>"
     <%= tag.attributes(tickable("collected", trainer.tick || id)) %>>
  <span class="pn-wt-trainer__beaten"><%= t("walkthrough.ui.map_status_trainer_done") %></span>
  <%= progress_toast("trainer", name: trainer.name || trainer.cls) %>
  <div class="pn-wt-trainer__card">
  <div class="pn-wt-trainer__head">
    <div>
      <% if role %>
        <div class="pn-wt-trainer__cls"><%= role %></div>
      <% end %>
      <% if trainer.name %>
        <div class="pn-wt-trainer__cls"><%= trainer.cls %></div>
        <div class="pn-wt-trainer__name"><%= trainer.name %><%= trainer_floor_chip(floor) %></div>
      <% else %>
        <div class="pn-wt-trainer__name">
          <%= trainer.cls %>
          <% if trainer.marker_key? %>
            <%= map_mark(trainer.marker_key, at: trainer.tick) %>
          <% end %>
          <%= trainer_floor_chip(floor) %>
        </div>
      <% end %>
    </div>
    <div class="pn-wt-trainer__reward"><%= poke_dollar(trainer.reward) %></div>
  </div>
  <% if trainer.note_key? %>
    <div class="pn-wt-trainer__note">
      <b class="pn-wt-trainer__note-label"><%= t("walkthrough.ui.trainer_note_label") %></b>
      <span><%= t(trainer.note_key) %></span>
    </div>
  <% end %>
  <div class="pn-wt-trainer__shots">
    <div class="pn-wt-shot pn-wt-shot--vs">
      <%= r2_image_tag "walkthrough/yellow/trainers/#{trainer.sprite}.png", alt: "", class: "pn-wt-shot__img pn-wt-shot__img--vs", loading: "lazy" %>
      <span class="pn-wt-shot__label"><%= t("walkthrough.ui.vs") %></span>
    </div>
    <div class="pn-wt-shot pn-wt-shot--where">
      <% if trainer.where&.map? %>
        <%= r2_image_tag trainer.where.image, alt: "", class: "pn-wt-shot__img", loading: "lazy", width: 160, height: 144 %>
      <% else %>
        <div class="pn-wt-shot__ph"><%= t("walkthrough.ui.shot_placeholder") %></div>
      <% end %>
      <span class="pn-wt-shot__label pn-wt-shot__label--where"><%= t("walkthrough.ui.where") %></span>
    </div>
  </div>
  <% if trainer.battle&.map? %>
    <div class="pn-wt-shot pn-wt-shot--battlescreen">
      <%= r2_image_tag trainer.battle.image, alt: "", class: "pn-wt-shot__img", loading: "lazy", width: 160, height: 144 %>
      <span class="pn-wt-shot__scan" aria-hidden="true"></span>
      <span class="pn-wt-shot__label pn-wt-shot__label--battle"><%= t("walkthrough.ui.battle") %></span>
    </div>
  <% end %>
  <div class="pn-wt-trainer__team">
    <% trainer.team.each do |member| %>
      <div class="pn-wt-team-mon">
        <span class="pn-wt-team-mon__sprite"><%= r2_image_tag "pokemon/yellow/#{member[:dex]}.png", alt: "", loading: "lazy" %></span>
        <div>
          <% unless compact %>
            <div class="pn-wt-team-mon__name"><%= member[:name] %></div>
          <% end %>
          <div class="pn-wt-team-mon__lvl"><%= t("walkthrough.ui.lv", n: member[:lvl]) %></div>
        </div>
      </div>
    <% end %>
  </div>
  </div>
</div>
