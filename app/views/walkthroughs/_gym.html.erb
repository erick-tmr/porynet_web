<section class="pn-wt-section">
  <div class="pn-wt-gym pn-wt-gym--<%= gym_grid_tone(gym.badge) %>">
    <div class="pn-wt-gym__grid" aria-hidden="true"></div>
    <div class="pn-wt-gym__inner">
      <div class="pn-wt-gym__head">
        <div class="pn-wt-gym__headmain">
          <div class="pn-wt-gym__tags">
            <span class="pn-wt-gym__tag"><%= t("walkthrough.ui.gym_tag") %></span>
            <span class="pn-wt-gym__type"><%= t("walkthrough.ui.gym_type", type: gym.type) %></span>
          </div>
          <h3 class="pn-wt-gym__name"><%= gym.name %></h3>
          <p class="pn-wt-gym__intro"><%= t(gym.intro_key) %></p>
        </div>
        <div class="<%= class_names("pn-wt-gym__shot-wrap", "is-routed" => gym.area&.route?) %>"
             data-controller="map-markers"
             data-map-markers-game-value="<%= @game.slug %>"
             data-map-markers-map-value="<%= gym.area&.name %>"
             data-map-markers-route-value="<%= gym.area&.route? %>"
             data-map-markers-native-w-value="<%= gym.area&.width %>">
          <div class="pn-wt-shot pn-wt-shot--gym">
            <% if gym.area? %>
              <div class="pn-wt-gym__canvas" data-map-markers-target="canvas"
                   data-action="click->map-markers#dismiss">
                <%= r2_image_tag gym.area.image, alt: "", class: "pn-wt-shot__map-img", loading: "lazy",
                                 width: gym.area.width, height: gym.area.height %>
                <% if gym.area.route? %><%= render "map_route", area: gym.area %><% end %>
                <div class="pn-mm-layer" data-map-markers-target="layer">
                  <% gym.pins.each do |marker| %>
                    <%= render "map_marker", marker: marker, slug: slug %>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="pn-wt-shot__ph pn-wt-shot__ph--gym"><%= t("walkthrough.ui.shot_placeholder") %></div>
            <% end %>
            <span class="pn-wt-shot__label pn-wt-shot__label--gym"><%= t("walkthrough.ui.gym_short") %></span>
          </div>
          <% if gym.area&.route? %>
            <div class="pn-wt-gym__toggles">
              <button type="button" class="pn-mm-toggle pn-wt-gym__routebtn is-on" aria-pressed="true"
                      data-map-markers-target="routeToggle" data-action="click->map-markers#toggleRoute">
                <%= t("walkthrough.ui.map_route_#{gym.area.route_kind}") %>
                <span class="pn-mm-toggle__on"><%= t("walkthrough.ui.map_labels_on") %></span>
                <span class="pn-mm-toggle__off"><%= t("walkthrough.ui.map_labels_off") %></span>
              </button>
              <%# A warp gym pins every pad with the room it lands in, which is thirty names over one
                  small floor. The arrows are the instruction; the names are there to be read once,
                  so they come off the same way they do on any other map. %>
              <% if gym.pins.many? { |pin| pin.cat == "exit" } %>
                <button type="button" class="pn-mm-toggle is-on" aria-pressed="true"
                        data-map-markers-target="labelToggle" data-action="click->map-markers#toggleLabels">
                  <%= t("walkthrough.ui.map_labels") %>
                  <span class="pn-mm-toggle__on"><%= t("walkthrough.ui.map_labels_on") %></span>
                  <span class="pn-mm-toggle__off"><%= t("walkthrough.ui.map_labels_off") %></span>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <% if gym.needs? %>
        <div class="pn-wt-gym__needs">
          <span class="pn-wt-gym__needs-badge"><%= t("walkthrough.ui.gym_needs", hm: gym.needs) %></span>
          <p class="pn-wt-gym__needs-text"><%= t(gym.needs_key) %></p>
        </div>
      <% end %>

      <% if gym.puzzle? %>
        <div class="pn-wt-gym__puzzle">
          <span class="pn-wt-gym__puzzle-badge"><%= t("walkthrough.ui.gym_puzzle") %></span>
          <div class="pn-wt-gym__psteps">
            <% gym.puzzle.each do |pstep| %>
              <div class="pn-wt-gym__pstep">
                <span class="pn-wt-gym__pstep-n"><%= pstep.n %></span>
                <div class="pn-wt-gym__pstep-text"><%= t(pstep.text_key) %></div>
                <% if pstep.answers? %>
                  <ol class="pn-wt-quiz">
                    <% pstep.answers.each_with_index do |answer, i| %>
                      <li class="pn-wt-quiz__door">
                        <span class="pn-wt-quiz__n"><%= t("walkthrough.ui.quiz_door", n: i + 1) %></span>
                        <span class="pn-wt-quiz__answer pn-wt-quiz__answer--<%= answer %>">
                          <%= t("walkthrough.ui.quiz_#{answer}") %>
                        </span>
                      </li>
                    <% end %>
                  </ol>
                <% end %>
                <% if pstep.shot? %>
                  <div class="pn-wt-shot pn-wt-shot--pstep">
                    <% if pstep.shot.map? %>
                      <%= r2_image_tag pstep.shot.image, alt: "", class: "pn-wt-shot__map-img", loading: "lazy" %>
                    <% else %>
                      <div class="pn-wt-shot__ph pn-wt-shot__ph--gym"><%= t("walkthrough.ui.shot_placeholder") %></div>
                    <% end %>
                    <span class="pn-wt-shot__label pn-wt-shot__label--gym"><%= pstep.shot.label %></span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# The walk itself, for a stop whose whole page is this one room: the floor is drawn above
          it and each step crops its own leg out of that floor, so the two belong together. On a
          floor whose way through is the puzzle, the walk is the solution, so it takes that block's
          frame and its badge rather than standing beside a second list saying the same thing. %>
      <% if steps.any? %>
        <div class="pn-wt-gym__puzzle">
          <span class="pn-wt-gym__puzzle-badge"><%= t("walkthrough.ui.gym_puzzle") %></span>
          <div class="pn-wt-steps pn-wt-steps--gym">
            <% steps.each do |step| %>
              <%= render "step", step: step, slug: slug %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if gym.trainers? %>
        <div class="pn-wt-gym__label"><%= t("walkthrough.ui.gym_trainers_inside", count: gym.trainers.size) %></div>
        <div class="pn-wt-trainers pn-wt-trainers--gym">
          <% gym.trainers.each_with_index do |trainer, i| %>
            <%= render "trainer", trainer: trainer, id: "#{slug}/gym-trainer-#{i}",
                       role: t("walkthrough.ui.gym_trainer") %>
          <% end %>
        </div>
      <% end %>

      <div class="pn-wt-gym__label"><%= t("walkthrough.ui.gym_leader_label") %></div>
      <div class="pn-wt-gym__leader" <%= tag.attributes(tickable("collected", gym.leader.tick || "#{slug}/gym-leader")) %>>
        <span class="pn-wt-gym__leader-cleared"><%= t("walkthrough.ui.gym_cleared") %></span>
        <%= progress_toast("trainer", name: gym.leader.name) %>
        <div class="pn-wt-gym__leader-card">
        <div class="pn-wt-gym__leader-id">
          <div class="pn-wt-shot pn-wt-shot--leadervs">
            <%= r2_image_tag "walkthrough/yellow/trainers/#{gym.leader.sprite}.png", alt: "", class: "pn-wt-shot__img pn-wt-shot__img--fill", loading: "lazy" %>
            <span class="pn-wt-shot__label pn-wt-shot__label--gym"><%= t("walkthrough.ui.vs") %></span>
          </div>
          <% if gym.leader.battle&.map? %>
            <div class="pn-wt-shot pn-wt-shot--leaderbattle">
              <%= r2_image_tag gym.leader.battle.image, alt: "", class: "pn-wt-shot__img", loading: "lazy" %>
              <span class="pn-wt-shot__scan" aria-hidden="true"></span>
              <span class="pn-wt-shot__label pn-wt-shot__label--battle"><%= t("walkthrough.ui.battle") %></span>
            </div>
          <% end %>
          <div class="pn-wt-gym__leader-meta">
            <div class="pn-wt-gym__leader-role"><%= t("walkthrough.ui.gym_leader") %></div>
            <div class="pn-wt-gym__leader-name">
              <%= gym.leader.name %>
              <% if gym.leader.marker_key? %>
                <%= map_mark(gym.leader.marker_key, at: gym.leader.tick) %>
              <% end %>
            </div>
            <div class="pn-wt-gym__leader-pills">
              <span class="pn-wt-gym__pill pn-wt-gym__pill--reward"><%= poke_dollar(gym.leader.reward) %></span>
              <span class="pn-wt-gym__pill"><%= gym.tm %></span>
            </div>
            <div class="pn-wt-gym__badge">
              <div class="pn-wt-gym__badge-frame">
                <%= r2_image_tag gym.badge_img, alt: t("walkthrough.ui.badge_alt", badge: gym.badge), class: "pn-wt-gym__badge-img" %>
              </div>
              <div class="pn-wt-gym__badge-meta">
                <div class="pn-wt-gym__badge-name"><%= gym.badge %></div>
                <div class="pn-wt-gym__badge-cap pn-wt-gym__badge-cap--todo"><%= t("walkthrough.ui.badge_not_earned") %></div>
                <div class="pn-wt-gym__badge-cap pn-wt-gym__badge-cap--done"><%= t("walkthrough.ui.badge_collected") %></div>
              </div>
            </div>
          </div>
        </div>
        <div class="pn-wt-gym__roster">
          <div class="pn-wt-gym__label"><%= t("walkthrough.ui.gym_roster") %></div>
          <div class="pn-wt-gym__mons">
            <% gym.leader.team.each do |member| %>
              <div class="pn-wt-gym__mon">
                <span class="pn-wt-gym__mon-sprite"><%= r2_image_tag "pokemon/yellow/#{member[:dex]}.png", alt: "" %></span>
                <div class="pn-wt-gym__mon-name"><%= member[:name] %></div>
                <div class="pn-wt-gym__mon-lvl"><%= t("walkthrough.ui.lv", n: member[:lvl]) %></div>
              </div>
            <% end %>
          </div>
        </div>
        <% if gym.leader.note_key? %>
          <div class="pn-wt-gym__leader-note">
            <b class="pn-wt-gym__leader-note-label"><%= t("walkthrough.ui.mew_glitch_label") %></b>
            <span><%= t(gym.leader.note_key) %></span>
          </div>
        <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
