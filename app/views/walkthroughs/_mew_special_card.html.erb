<% mg = "#{Walkthrough::Yellow::K}.mew_glitch" %>
<%= link_to walkthrough_mew_glitch_path(game: game.slug), class: "pn-wt-special pn-wt-special--glitch" do %>
  <%= r2_image_tag "pokemon/yellow/151.png", alt: "", class: "pn-wt-special__sprite" %>
  <div class="pn-wt-special__main">
    <div class="pn-wt-special__meta">
      <span class="pn-wt-special__tag"><%= t("#{mg}.index.kind") %></span>
      <span class="pn-wt-special__where"><%= t("#{mg}.index.where") %></span>
    </div>
    <div class="pn-wt-special__name"><%= t("#{mg}.index.name") %></div>
    <div class="pn-wt-special__note"><%= t("#{mg}.index.note") %></div>
  </div>
  <span class="pn-wt-special__arrow">▶</span>
<% end %>
