<% best = local_assigns[:best] %>
<div class="<%= class_names("pn-wt-catch", "pn-wt-catch--best" => best, "pn-wt-catch--gift" => enc.from?) %>"
     <%= tag.attributes(catch_card_attributes(enc.dex, entry)) %>>
  <%= render "catch_badges", entry: entry, slug: slug, needs_label: enc.how %>
  <% if enc.from? %>
    <div class="pn-wt-catch__gift">
      <span class="pn-wt-catch__gift-dot" aria-hidden="true"></span>
      <span class="pn-wt-catch__gift-label"><%= t("walkthrough.ui.gift_badge") %></span>
      <span class="pn-wt-catch__gift-sep" aria-hidden="true"></span>
      <span class="pn-wt-catch__gift-from"><%= t(enc.from_key) %></span>
    </div>
  <% end %>
  <span class="pn-wt-catch__caught"><%= t("walkthrough.ui.caught_badge") %></span>
  <%= progress_toast("caught", name: enc.name) %>
  <% if best %>
    <div class="pn-wt-best">
      <div class="pn-wt-best__head">
        <span class="pn-wt-best__star" aria-hidden="true">★</span>
        <span class="pn-wt-best__label"><%= t("walkthrough.ui.best_badge") %></span>
      </div>
      <div class="pn-wt-best__reason"><%= best_catch_reason(best, enc) %></div>
    </div>
  <% end %>
  <div class="pn-wt-catch__top">
    <div class="pn-wt-catch__sprite"><%= r2_image_tag "pokemon/yellow/#{enc.dex}.png", alt: "" %></div>
    <div class="pn-wt-catch__info">
      <div class="pn-wt-catch__id">
        <span class="pn-wt-catch__num">#<%= enc.dex %></span>
        <span class="pn-wt-catch__name"><%= enc.name %></span>
        <% if entry %>
          <span class="pn-wt-catchpill pn-wt-catchpill--living">
            <span class="pn-wt-catchpill__todo"><%= body_pill(entry.qty) %></span>
            <span class="pn-wt-catchpill__done"><%= t("walkthrough.ui.pill_box_done") %></span>
          </span>
          <span class="pn-wt-catchpill pn-wt-catchpill--oak">
            <span class="pn-wt-catchpill__todo"><%= t("walkthrough.ui.pill_not_registered") %></span>
            <span class="pn-wt-catchpill__done"><%= t("walkthrough.ui.pill_registered") %></span>
          </span>
        <% end %>
      </div>
      <div class="pn-wt-catch__chips">
        <span class="pn-wt-tagpill pn-wt-tagpill--<%= enc.how.parameterize %>"><%= enc.how %></span>
        <% if enc.rarity != enc.how %>
          <span class="pn-wt-tagpill pn-wt-tagpill--<%= enc.rarity.downcase %>"><%= enc.rarity %></span>
        <% end %>
      </div>
      <div class="pn-wt-catch__stats">
        <div>
          <div class="pn-wt-catch__stat-label"><%= t("walkthrough.ui.rate") %></div>
          <div class="pn-wt-catch__stat-val"><%= enc.rate %></div>
        </div>
        <div>
          <div class="pn-wt-catch__stat-label"><%= t("walkthrough.ui.level") %></div>
          <div class="pn-wt-catch__stat-val"><%= enc.level %></div>
        </div>
      </div>
    </div>
  </div>

  <% if enc.places? %>
    <% best = enc.best_place %>
    <div class="pn-wt-floors">
      <div class="pn-wt-floors__head">
        <span><%= t("walkthrough.ui.floors_label") %></span>
        <span><%= t("walkthrough.ui.floors_level") %></span>
      </div>
      <ul class="pn-wt-floors__list">
        <% enc.places.each do |place| %>
          <li class="<%= class_names("pn-wt-floors__row", "is-best" => place == best) %>">
            <% if place.floor %><span class="pn-wt-floors__chip"><%= place.floor %></span><% end %>
            <span class="pn-wt-floors__how pn-wt-floors__how--<%= place.kind.dasherize %>"><%= encounter_method_label(place, enc.how) %></span>
            <span class="pn-wt-floors__track">
              <span class="<%= floor_bar_class(place, best) %>"></span>
            </span>
            <span class="pn-wt-floors__rate"><%= t("walkthrough.ui.floors_rate", rate: place.rate) %></span>
            <span class="pn-wt-floors__lv"><%= place.levels %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if enc.unlock? %>
    <div class="pn-wt-catch__unlock">
      <%= r2_image_tag enc.unlock_icon, alt: "", class: "pn-wt-catch__unlock-sprite" %>
      <div>
        <div class="pn-wt-catch__unlock-label"><%= t("walkthrough.ui.unlock_condition") %></div>
        <div class="pn-wt-catch__unlock-text"><%= t(enc.unlock_key) %></div>
      </div>
    </div>
  <% end %>

  <div class="pn-wt-evo">
    <div class="pn-wt-evo__label"><%= t("walkthrough.ui.evo_line") %></div>
    <div class="pn-wt-evo__line">
      <% enc.evo_line.each_with_index do |stage, i| %>
        <% if i.positive? %><span class="pn-wt-evo__arrow">▶</span><% end %>
        <% current = stage[:dex] == enc.dex %>
        <div class="<%= class_names("pn-wt-evo__stage", "is-current" => current) %>">
          <div class="<%= class_names("pn-wt-evo__box", "is-current" => current) %>">
            <%= r2_image_tag "pokemon/yellow/#{stage[:dex]}.png", alt: "" %>
          </div>
          <span class="pn-wt-evo__name"><%= stage[:name] %></span>
        </div>
      <% end %>
    </div>
  </div>

  <% if enc.tip_key %>
    <div class="pn-wt-catch__tip"><b><%= t("walkthrough.ui.tip") %></b> · <%= t(enc.tip_key) %></div>
  <% end %>

  <div class="pn-wt-catch__count" data-action="click->body-counter#stop">
    <div class="pn-wt-stepper">
      <button type="button" class="pn-wt-stepper__btn" data-action="body-counter#remove"
              aria-label="<%= t("walkthrough.ui.ld_remove") %>">−</button>
      <span class="pn-wt-stepper__count" data-body-counter-target="have">0</span>
      <button type="button" class="pn-wt-stepper__btn pn-wt-stepper__btn--add"
              data-action="body-counter#add"
              aria-label="<%= t("walkthrough.ui.ld_add") %>">+</button>
    </div>
    <span class="pn-wt-catch__owned"><%= owned_line %></span>
  </div>
</div>
