<% content_for :page_controller do %><%= walkthrough_page_controller(@game) %><% end %>
<% content_for :title, t("walkthrough.ui.title_location", name: @location.title, game: @game.name) %>
<% plan = @game.plan_for(@leg) %>
<%# The League is the one stop whose trainers are the page: five rooms in a row, each its own
    plate, so the standard trainer grid stands down in favour of them. %>
<% league = Walkthrough::Yellow.elite_four(@location) if @location.slug == "indigo-plateau" %>
<%# The last page of the guide signs off under its last stop, so the cave carries a section no
    other stop has. %>
<% ending = Walkthrough::Yellow.true_ending(@location) if @location.slug == "cerulean-cave" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "components/leg-switch", "pages/walkthrough", "pages/walkthrough-map",
                          "pages/walkthrough-challenge", "data-turbo-track": "reload" %>
  <% if league %>
    <%= stylesheet_link_tag "pages/elite-four", "data-turbo-track": "reload" %>
  <% end %>
  <% if ending %>
    <%= stylesheet_link_tag "pages/cerulean-cave", "data-turbo-track": "reload" %>
  <% end %>
<% end %>
<% content_for :nav_crumb do %>
  <%= link_to @game.name.upcase, walkthrough_path(game: @game.slug) %>
  <span class="pn-nav__crumb-sep">/</span>
  <span class="pn-nav__crumb-here"><%= @location.title.upcase %></span>
<% end %>

<section class="pn-wt-section pn-wt-loc">
  <div class="pn-wt-loc__tags">
    <%= link_to t("walkthrough.ui.back"), walkthrough_path(game: @game.slug, anchor: @leg.slug), class: "pn-wt-back" %>
    <span class="pn-wt-tag"><%= t("walkthrough.ui.stop", n: format("%02d", @location.order), kind: @location.kind) %></span>
    <span class="pn-wt-tag pn-wt-tag--mode"><%= t("walkthrough.ui.mode_tag") %></span>
  </div>
  <h1 class="pn-wt-loc__title"><%= accent_last(@location.title) %></h1>
  <p class="pn-wt-loc__lead"><%= t(@location.intro_key) %></p>
</section>

<div class="pn-legsw-host" data-controller="leg-switcher">
<%= render "shared/stop_bar", stops: [ [ @location, plan.queue_at(@location.slug).sum(&:qty) ] ] %>

<% if @location.slug == "rocket-hideout" %>
  <%= render "prize_room", room: Walkthrough::Yellow.game_corner_prizes %>
<% end %>

<% groups = @location.step_groups %>
<% drawn = groups.filter_map(&:first).map(&:name) %>
<% if groups.any? %>
  <% groups.each_with_index do |(area, steps), index| %>
    <% if area %>
      <section class="pn-wt-section pn-wt-maps">
        <%= render "area_map_block", loc: @location, area: area, show_howto: index.zero? %>
      </section>
    <% end %>
    <%= render "steps_section", loc: @location, steps: steps, heading: index.zero? %>
    <% here = @location.encounters_on(area&.name) %>
    <% if here.any? %>
      <%= render "catch_here", loc: @location, encounters: here, plan: plan, level: :page %>
    <% end %>
    <% if @location.grind&.after?(area) %><%= render "grind_spot", grind: @location.grind %><% end %>
    <% swaps = @location.trades_on(area&.name) %>
    <% if swaps.any? %><%= render "trades_here", loc: @location, trades: swaps, level: :page %><% end %>
  <% end %>
<% else %>
  <% if @location.area_maps? %><%= render "area_map", loc: @location %><% end %>
  <%# The diary is what the mansion is remembered for, and its four pages are scattered over the
      floors the steps cross, so it is read once between the maps and the walk rather than four
      times in passing. %>
  <% if @location.slug == "pokemon-mansion" %><%= render "mansion_diary" %><% end %>
  <%= render "steps_section", loc: @location, steps: @location.lead_steps, heading: true %>
<% end %>

<% if @location.second_visit? %><%= render "second_visit", loc: @location %><% end %>

<% if @location.slug == "safari-zone" %><%= render "safari_catching" %><% end %>

<% if @location.later? %><%= render "later_section", loc: @location %><% end %>

<% elsewhere = @location.encounters_off(drawn) %>
<% if elsewhere.any? %>
  <%= render "catch_here", loc: @location, encounters: elsewhere, plan: plan, level: :page %>
<% end %>

<% if @location.trivia? %><%= render "trivia", trivia: @location.trivia %><% end %>

<% if league %>
  <%= render "elite_four", league: league %>
<% elsif @location.trainers.any? %>
  <section class="pn-wt-section">
    <div class="pn-eyebrow-label"><%= t("walkthrough.ui.trainers_eyebrow", count: @location.trainers.size) %></div>
    <h2 class="pn-h2"><%= t("walkthrough.ui.trainers_h2") %></h2>
    <%= render "trainers", trainers: @location.trainers, slug: @location.slug, dense: @location.dense_trainers? %>
  </section>
<% end %>

<%# The steps held back behind the page's hall, which on the League page is the five rooms: where
    the file goes once the credits have rolled belongs under them, not above the fight it follows. %>
<% if @location.after_steps.any? %>
  <section class="pn-wt-section">
    <div class="pn-eyebrow-label"><%= t("walkthrough.ui.steps_next_eyebrow") %></div>
    <h2 class="pn-h2"><%= t("walkthrough.ui.steps_next_h2") %></h2>
    <div class="pn-wt-steps">
      <% @location.after_steps.each do |step| %>
        <%= render "step", step: step, slug: @location.slug %>
      <% end %>
    </div>
  </section>
<% end %>

<% left = @location.trades_off(drawn) %>
<% if left.any? %><%= render "trades_here", loc: @location, trades: left, level: :page %><% end %>

<%= render "challenges", plan: plan, multi: false %>

<% if ending %><%= render "true_ending", ending: ending %><% end %>
</div>

<%= render "leg_nav", game: @game, leg: @leg %>
