<% content_for :title, t("account.meta.register") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/auth", "data-turbo-track": "reload" %>
<% end %>
<% content_for :nav_marquee do %>
  <%= render "shared/marquee_row", items: t("account.marquee") %>
  <%= render "shared/marquee_row", items: t("account.marquee") %>
<% end %>

<%= render "shared/auth_hero", key: "register" %>

<section class="pn-auth">
  <div class="pn-auth__panel">
    <%= render "shared/auth_tabs", active: :register %>
    <div class="pn-auth__body">
      <%= render "shared/auth_oauth", mode: "register" %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                   html: { class: "pn-auth__form", novalidate: true }) do |f| %>
        <%= render "shared/form_errors", record: resource %>

        <div class="pn-auth__row">
          <%= render "shared/field", f: f, name: :trainer_name, kind: :text_field, tone: :sky,
                     label: t("account.fields.trainer_name"),
                     placeholder: t("account.fields.trainer_name_placeholder"),
                     hint: t("account.fields.trainer_name_hint"),
                     options: { autofocus: true, autocomplete: "username", maxlength: 12,
                                required: true } %>
          <%= render "shared/field", f: f, name: :email, kind: :email_field, tone: :sky,
                     label: t("account.fields.email"),
                     placeholder: t("account.fields.email_placeholder"),
                     hint: t("account.fields.email_hint"),
                     options: { autocomplete: "email", required: true } %>
        </div>

        <div class="pn-auth__row">
          <%= render "shared/field", f: f, name: :password, kind: :password_field, tone: :sky,
                     label: t("account.fields.password"),
                     placeholder: t("account.fields.password_placeholder"),
                     hint: t("account.fields.password_hint", count: @minimum_password_length),
                     options: { autocomplete: "new-password", required: true,
                                minlength: @minimum_password_length } %>
          <%= render "shared/field", f: f, name: :password_confirmation, kind: :password_field,
                     tone: :sky,
                     label: t("account.fields.password_confirmation"),
                     placeholder: t("account.fields.password_placeholder"),
                     options: { autocomplete: "new-password", required: true } %>
        </div>

        <div>
          <span class="pn-auth__avatars-label"><%= t("account.register.avatar_heading") %></span>
          <div class="pn-auth__avatars">
            <% User::AVATARS.each do |avatar| %>
              <label class="pn-auth__avatar">
                <%= f.radio_button :avatar, avatar, class: "pn-auth__avatar-input" %>
                <span class="pn-auth__avatar-art">
                  <%= r2_image_tag "account/avatars/#{avatar}.png", alt: "" %>
                </span>
                <span class="pn-auth__avatar-name">
                  <%= t("account.register.avatars.#{avatar}.name") %>
                </span>
                <span class="pn-auth__avatar-games">
                  <%= t("account.register.avatars.#{avatar}.games") %>
                </span>
                <span class="pn-auth__avatar-picked"><%= t("account.register.picked") %></span>
              </label>
            <% end %>
          </div>
        </div>

        <label class="pn-check pn-check--sky">
          <span class="pn-check__box">
            <%= f.check_box :terms, class: "pn-check__input" %>
            <span class="pn-check__tick" aria-hidden="true">✔</span>
          </span>
          <span><%= t("account.register.terms") %></span>
        </label>

        <%= f.submit t("account.register.submit"),
                     class: "pn-btn pn-btn--sky pn-btn--block pn-auth__submit" %>
      <% end %>

      <div class="pn-auth__foot">
        <%= t("account.register.has_account_html",
              link: link_to(t("account.register.has_account_link"), new_user_session_path)) %>
      </div>
    </div>
  </div>

  <%= render "shared/auth_aside" %>
</section>
